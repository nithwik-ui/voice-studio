# VoiceFlow Studio Backend Environment Configuration
# DO NOT COMMIT SECRETS TO VERSION CONTROL.
# Use this template to create a `.env.local` or `.env.staging` file.

# Supabase Configuration
SUPABASE_URL="https://<project-id>.supabase.co"
SUPABASE_SECRET_KEY="<your-service-role-key>"
# Keep the frontend publishable key for public client calls if required on the backend
NEXT_PUBLIC_SUPABASE_URL="https://<project-id>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<your-anon-key>"

# Google OAuth & Drive Integration
GOOGLE_CLIENT_ID="<your-google-oauth-client-id>.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="<your-google-client-secret>"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/auth/google/callback"
# Folder ID for the root of the "VoiceFlow Studio Staging" or Production directory
GOOGLE_DRIVE_ROOT_FOLDER_ID="<your-drive-folder-id>"

# Redis / Celery Task Queue
REDIS_URL="redis://localhost:6379/0"

# Application Settings
API_URL="http://localhost:8000"
SESSION_SECRET="<your-random-secure-session-string>"

# Dependencies
# Path to FFmpeg executable (e.g., /usr/bin/ffmpeg or C:/ffmpeg/bin/ffmpeg.exe)
FFMPEG_PATH="ffmpeg"
